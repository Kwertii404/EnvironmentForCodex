      "from": 1470,
      "frames": 330,
      "cues": [
        {
          "start": 14,
          "duration": 4.034,
          "file": "vo-5-0.wav",
          "text": "Below, equipment condition and laboratory summaries add context."
        },
        {
          "start": 140,
          "duration": 5.720041666666667,
          "file": "vo-5-1.wav",
          "text": "The sidebar navigation keeps equipment, maintenance, reference data, and accounts within reach."
