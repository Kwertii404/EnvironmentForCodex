          "start": 14,
          "duration": 4.376666666666667,
          "file": "vo-9-0.wav",
          "text": "Opening View lets us check the saved details before making a change."
        },
        {
          "start": 150,
          "duration": 3.3884166666666666,
          "file": "vo-9-1.wav",
          "text": "We are following the same item throughout this demonstration."
