    {
      "index": 6,
      "from": 1800,
      "frames": 420,
      "cues": [
        {
          "start": 14,
          "duration": 2.432,
          "file": "vo-6-0.wav",
          "text": "Let\u2019s follow one disposable sample."
        },
        {
          "start": 92,
          "duration": 6.8693333333333335,
          "file": "vo-6-1.wav",
          "text": "We enter its asset tag, choose its category and laboratory, and add the brand, model, and serial number."
