      "from": 1110,
      "frames": 360,
      "cues": [
        {
          "start": 14,
          "duration": 7.381333333333333,
          "file": "vo-4-0.wav",
          "text": "The dashboard summarizes equipment conditions and active maintenance, with this month\u2019s completed maintenance costs above."
        },
        {
          "start": 240,
          "duration": 2.3466666666666667,
          "file": "vo-4-1.wav",
          "text": "These figures come from our sample records."
        }
