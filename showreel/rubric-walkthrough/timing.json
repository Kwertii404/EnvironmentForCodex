    {
      "index": 7,
      "from": 2220,
      "frames": 300,
      "cues": [
        {
          "start": 14,
          "duration": 3.6932916666666666,
          "file": "vo-7-0.wav",
          "text": "After saving, LabTracker confirms that the equipment was added."
        },
        {
          "start": 130,
          "duration": 5.066291666666666,
          "file": "vo-7-1.wav",
          "text": "The detail page brings the stored information together in one readable record."
        }
      ]
    },
    {
      "index": 8,
      "from": 2520,
      "frames": 330,
      "cues": [
        {
          "start": 14,
          "duration": 2.496,
          "file": "vo-8-0.wav",
          "text": "Next, we search for the sample asset tag."
        },
        {
          "start": 94,
          "duration": 5.504,
          "file": "vo-8-1.wav",
          "text": "The matching row gives us direct access to viewing, editing, and deleting that equipment."
